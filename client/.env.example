# Copy this file to .env and fill in your Supabase project values.
# These are exposed to the browser (PUBLIC_ prefix) — never put secret keys here.

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auth setup (no SMTP / no paid email service required):
# 1. Run client/supabase/schema.sql in the Supabase SQL editor
# 2. Supabase dashboard → Authentication → Providers → Email
#    → turn OFF "Confirm email" → Save
